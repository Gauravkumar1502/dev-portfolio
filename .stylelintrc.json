{
  "extends": ["stylelint-config-standard-scss", "stylelint-config-recess-order"],
  "ignoreFiles": ["dist/**", ".angular/**", "node_modules/**"],
  "rules": {
    "selector-pseudo-element-no-unknown": [true, { "ignorePseudoElements": ["ng-deep"] }],
    "selector-pseudo-class-no-unknown": [true, { "ignorePseudoClasses": ["host", "host-context"] }],
    "selector-type-no-unknown": [true, { "ignore": ["custom-elements"] }],
    "selector-class-pattern": [
      "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
      { "message": "Use kebab-case / BEM classes (block__element--modifier)" }
    ],
    "max-nesting-depth": [3, { "ignore": ["pseudo-classes", "blockless-at-rules"] }],
    "selector-max-id": 0,
    "selector-max-compound-selectors": 4,
    "declaration-no-important": [true, { "severity": "warning" }],
    "color-named": "never",
    "color-no-hex": [
      true,
      { "message": "Use theme CSS variables (var(--color-*)) — raw colors belong in styles/themes" }
    ],
    "function-disallowed-list": [
      ["rgb", "rgba", "hsl", "hsla"],
      { "message": "Use theme CSS variables — raw colors belong in styles/themes" }
    ],
    "scss/load-no-partial-leading-underscore": true,
    "scss/at-rule-no-unknown": true,
    "scss/no-global-function-names": true,
    "custom-property-pattern": null
  },
  "overrides": [
    {
      "files": ["src/styles/themes/**/*.scss", "src/styles/_tokens.scss"],
      "rules": { "color-no-hex": null, "function-disallowed-list": null, "color-named": null }
    },
    {
      "files": ["src/styles.scss"],
      "rules": { "declaration-no-important": null }
    }
  ]
}
